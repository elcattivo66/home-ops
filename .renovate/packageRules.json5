{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Loose versioning for non-semver packages",
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackagePatterns": ["plex"]
    },
    {
      "description": "SearXNG tags are calver + commit sha and the image is released very frequently; limit updates to one PR per week",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/searxng/searxng"],
      "schedule": ["weekly"]
    },
  ]
}
