{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Loose versioning for non-semver packages",
      "matchDatasources": ["docker"],
      "versioning": "loose",
      "matchPackagePatterns": ["plex"]
    },
    {
      "description": "SearXNG tags are calver + commit sha and the image is released very frequently; limit updates to one PR per week",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/searxng/searxng"],
      "schedule": ["weekly"]
    },
    {
      "description": "Silo publishes ordered build-<n> tags instead of semver; the docker versioning treats them as unversioned, so map the tag onto a numeric major",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/silo-server/silo-server"],
      "versioning": "regex:^build-(?<major>\\d+)$",
      "pinDigests": true
    },
  ]
}
